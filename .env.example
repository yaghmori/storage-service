# @platform/storage-service

NODE_ENV=development
PORT=4000
TCP_PORT=4002

DATABASE_URL=postgresql://storage:storage@localhost:5434/storage_service

REDIS_HOST=localhost
REDIS_PORT=6381

UPLOAD_PATH=./uploads

# Local provider is default unless MinIO is fully configured + active
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage
MINIO_USE_SSL=false
# MINIO_ACTIVE=true

# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=
# AWS_S3_ACTIVE=false

# PRODUCTION_SEED=1

# Optional Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=storage-service

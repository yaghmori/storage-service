# @platform/storage-service

NODE_ENV=development
PORT=4000
TCP_PORT=4002

DATABASE_URL=postgresql://storage:storage@localhost:5434/storage_service

REDIS_HOST=localhost
REDIS_PORT=6381

UPLOAD_PATH=./uploads

# HTTP auth
AUTH_API_KEYS=dev-local-key
# AUTH_DISABLED=true
# JWT_SECRET=change-me-in-development

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage
MINIO_USE_SSL=false

# Optional Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=storage-service
# KAFKA_SSL=false
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

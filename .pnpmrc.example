# pnpm configuration for faster downloads
# Copy this to .pnpmrc in the root directory if you want to use a registry mirror

# Increase network concurrency for parallel downloads
network-concurrency=16

# Retry settings for slow networks
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Use a registry mirror if npmjs.org is slow in your region
# Uncomment and set your preferred registry:
# registry=https://registry.npmmirror.com
# Or use a CDN:
# registry=https://registry.npmjs.org

# Store location (already set via ENV in Dockerfile)
# store-dir=/pnpm/store


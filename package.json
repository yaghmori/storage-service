{
  "name": "@platform/storage-service",
  "version": "1.0.0",
  "description": "Object storage microservice for platform assets (avatars, docs, images)",
  "license": "MIT",
  "private": false,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --ignore dist --exec \"tsx src/main.ts\"",
    "dev:debug": "tsx watch --inspect=9229 src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "db:seed": "tsx src/database/seed/seed.ts"
  },
  "keywords": [
    "storage",
    "s3",
    "minio",
    "assets",
    "microservice",
    "nestjs"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@bull-board/ui": "^6.15.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@platform/messaging-contracts": "file:../messaging-contracts",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "exifr": "^7.1.3",
    "fluent-ffmpeg": "^2.1.2",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "minio": "^7.1.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.33.0",
    "tslib": "^2.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@img/sharp-linuxmusl-x64": "^0.33.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.25",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^1.4.11",
    "@types/node": "20.19.9",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract", "sharp"]
  }
}

# =============================================================================
# Storage service — production / CI seed (three providers, upsert by name)
# =============================================================================
# When PARS_LINKS_PRODUCTION_SEED=1: upserts Local Storage, MinIO Storage, AWS S3 Storage (same
# shape as dev export). MinIO endpoint must be your real host (e.g. minio or internal DNS), not localhost.
#
# MinIO: MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET (+ MINIO_PORT, MINIO_USE_SSL)
# S3: AWS_S3_* (see scripts/GITHUB_ACTIONS_SEED_VARIABLES.txt)
# Local: UPLOAD_PATH optional (default ./uploads)
# =============================================================================

MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACTIVE=true

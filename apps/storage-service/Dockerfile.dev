# Development Dockerfile for storage-service with TSX hot-reload
# Optimized for fast startup and efficient caching

# ============================================================================
# Stage 1: Base - Install pnpm and prepare environment
# ============================================================================
FROM docker.io/node:lts-alpine AS base

# Install pnpm, ts-node, tsconfig-paths, and nodemon globally
RUN npm install -g pnpm ts-node tsconfig-paths nodemon

# Configure pnpm environment
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_STORE_DIR="/pnpm/store"

# Configure pnpm for better network handling
ENV PNPM_NETWORK_CONCURRENCY=20
ENV PNPM_FETCH_RETRIES=5
ENV PNPM_FETCH_RETRY_MINTIMEOUT=30000
ENV PNPM_FETCH_RETRY_MAXTIMEOUT=120000
ENV PNPM_FETCH_TIMEOUT=180000
ENV PNPM_STRICT_PEER_DEPENDENCIES=false

WORKDIR /app

# ============================================================================
# Stage 2: Dependencies - Install all dependencies
# ============================================================================
FROM base AS dependencies

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml ./
COPY nx.json tsconfig.base.json tsconfig.json ./
COPY apps/storage-service/package.json ./apps/storage-service/
COPY apps/storage-service/tsconfig*.json ./apps/storage-service/

# Install dependencies with retry logic and cache mounts
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    --mount=type=cache,id=pnpm-cache,target=/root/.pnpm-cache \
    sh -c ' \
      echo "Installing dependencies with pnpm..."; \
      pnpm install --frozen-lockfile --prefer-offline || \
      (echo "Retry with reduced concurrency..." && \
       PNPM_NETWORK_CONCURRENCY=5 pnpm install --frozen-lockfile --prefer-offline) || \
      (echo "Final retry without optional deps..." && \
       pnpm install --frozen-lockfile --prefer-offline --no-optional) \
    '

# ============================================================================
# Stage 3: Development - Final stage with TSX runtime
# ============================================================================
FROM base AS development

# Copy configuration files
COPY package.json pnpm-lock.yaml ./
COPY nx.json tsconfig.base.json tsconfig.json ./
COPY apps/storage-service/package.json ./apps/storage-service/
COPY apps/storage-service/tsconfig*.json ./apps/storage-service/
COPY apps/storage-service/nodemon.json ./apps/storage-service/

# Copy installed dependencies from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules

# Create app directory structure
RUN mkdir -p ./apps/storage-service/src

# Copy source code (will be overridden by volume mounts in dev)
COPY apps/storage-service/src ./apps/storage-service/src

# Set working directory to the app
WORKDIR /app/apps/storage-service

# Expose application and debug ports
EXPOSE 4000 4001 9229

# Use nodemon with ts-node for hot reload
CMD nodemon --config nodemon.json

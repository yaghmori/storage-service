{
  "name": "@org/storage-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": ["--node-env=production"],
          "cwd": "apps/storage-service"
        },
        "configurations": {
          "development": {
            "args": ["--node-env=development"]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": {
          "buildTarget": "@org/storage-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/storage-service:build:development"
          },
          "production": {
            "buildTarget": "@org/storage-service:build:production"
          }
        }
      },
      "serve:tsx": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nodemon --watch src --exec \"ts-node --project tsconfig.app.json -r tsconfig-paths/register src/main.ts\"",
          "cwd": "apps/storage-service"
        }
      },
      "serve:tsx:debug": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nodemon --watch src --exec \"node --inspect=0.0.0.0:9229 -r ts-node/register -r tsconfig-paths/register src/main.ts\"",
          "cwd": "apps/storage-service"
        }
      },
      "prune-lockfile": {
        "dependsOn": ["build"],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/storage-service/dist/package.json",
          "{workspaceRoot}/apps/storage-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": ["build"],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/storage-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
        "executor": "nx:noop"
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": ["build", "prune"]
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit push",
          "cwd": "apps/storage-service"
        }
      },
      "migrate:up": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit up",
          "cwd": "apps/storage-service"
        }
      },
      "migrate:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit generate",
          "cwd": "apps/storage-service"
        }
      },
      "migrate:check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit check",
          "cwd": "apps/storage-service"
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ts-node --project tsconfig.app.json -r tsconfig-paths/register src/database/seed/seed.ts",
          "cwd": "apps/storage-service"
        }
      }
    }
  },
  "dependencies": {
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@bull-board/ui": "^6.15.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0"
  }
}

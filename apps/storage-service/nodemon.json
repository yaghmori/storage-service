{
  "watch": [
    "src",
    "../../tsconfig.base.json",
    "../../nx.json"
  ],
  "ext": "ts,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "**/node_modules/**"
  ],
  "exec": "ts-node --project tsconfig.app.json -r tsconfig-paths/register src/main.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "legacyWatch": true,
  "polling": true,
  "verbose": true,
  "restartable": "rs"
}


{
  "name": "@yaghmori/storage-service-server",
  "version": "1.0.0",
  "description": "Object storage microservice for platform assets (avatars, docs, images)",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "dev:debug": "node -r reflect-metadata -r ts-node/register/transpile-only --inspect=9229 src/main.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f api worker",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:dev": "node -r reflect-metadata -r ts-node/register/transpile-only src/main.ts",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/seed.js"
  },
  "keywords": [
    "storage",
    "s3",
    "minio",
    "assets",
    "microservice",
    "nestjs"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@bull-board/ui": "^6.15.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@workspace/validation": "workspace:^",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "exifr": "^7.1.3",
    "fluent-ffmpeg": "^2.1.2",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "minio": "^7.1.3",
    "multer": "^1.4.5-lts.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.33.0",
    "tslib": "^2.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@img/sharp-linuxmusl-x64": "^0.33.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.47",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}

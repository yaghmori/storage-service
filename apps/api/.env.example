# @yaghmori/storage-service-server

NODE_ENV=development
HOST=0.0.0.0
PORT=6100
TCP_HOST=0.0.0.0
TCP_PORT=6001
# Docker-services style (docker:dev): PORT=6100 TCP_PORT=6001
# Note: do not use HTTP 6000 — Node/undici fetch treats it as a blocked port.

# Host migrate/seed (docker-services Postgres on localhost:5432).
# docker:dev overrides this to postgres:5432 inside the compose network.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storage_service

REDIS_HOST=localhost
REDIS_PORT=6381

UPLOAD_PATH=./uploads

# HTTP auth — static keys bind to AUTH_DEFAULT_ORG_ID (usually Default).
# Prefer per-org DB API keys for Allyfe/Legacy (x-api-key from admin → org).
AUTH_API_KEYS=dev-local-key
# AUTH_DEFAULT_ORG_ID=<uuid from seed default org>  # only for static keys / TCP without orgSlug
# AUTH_DISABLED=true
JWT_SECRET=change-me-in-development
JWT_ISSUER=storage-service
ADMIN_JWT_EXPIRES_IN=365d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Org membership invites (nodemailer; falls back to logging accept URL if SMTP missing)
# ADMIN_APP_URL=http://localhost:6200
# SMTP_HOST=localhost
# SMTP_PORT=1025
# INVITE_SMTP_HOST=localhost
# INVITE_SMTP_PORT=1025
# INVITE_SMTP_FROM=noreply@example.com

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage
MINIO_USE_SSL=false
# Browser-facing host for signed URLs (required when MINIO_ENDPOINT is a Docker service name like "minio")
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Optional Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=storage-service

# Pluggable processors (AI / OpenAI-compatible e.g. Ollama)
# Required in production when storing API keys on processor_backends
PROCESSOR_CREDENTIALS_ENCRYPTION_KEY=change-me-32chars-min-dev-only
# Platform fallback when an org has no openai_compatible backend configured
# PROCESSOR_BACKEND_OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.10:11434/v1
# PROCESSOR_BACKEND_OPENAI_COMPATIBLE_API_KEY=
# PROCESSOR_BACKEND_OPENAI_COMPATIBLE_VISION_MODEL=llava
# PROCESSOR_BACKEND_OPENAI_COMPATIBLE_TIMEOUT_MS=120000

# Development image — hot-reload via nodemon + ts-node
# Build from monorepo root so @workspace/validation resolves.
#
#   context: repo root
#   dockerfile: apps/api/Dockerfile.dev

FROM node:20-alpine AS base

RUN corepack enable && corepack prepare pnpm@10.0.0 --activate \
 && npm install -g nodemon

# PDF/OCR/video tools (separate layer). Alpine CDN DNS can flake — retry apk.
RUN set -eux; \
  i=1; \
  while [ "$i" -le 5 ]; do \
    if apk update && apk add --no-cache ffmpeg poppler-utils tesseract-ocr libheif; then \
      break; \
    fi; \
    echo "apk attempt $i failed; retrying in 5s..."; \
    i=$((i + 1)); \
    sleep 5; \
  done; \
  command -v pdftoppm; \
  command -v pdftotext; \
  command -v tesseract

WORKDIR /app

FROM base AS development

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/config-typescript ./packages/config-typescript
COPY packages/config-eslint ./packages/config-eslint
COPY packages/validation ./packages/validation
COPY apps/api ./apps/api

# Install workspace graph for the API (includes @workspace/validation)
RUN pnpm install --filter @yaghmori/storage-service-server... --filter @workspace/validation... \
 && pnpm --filter @workspace/validation build

WORKDIR /app/apps/api

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=6100
ENV TCP_PORT=6001
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=1000

EXPOSE 6100 6001 6300

# Rebuild validation from mounted src so ProcessorKey / schemas stay in sync
# with host changes (dist is not volume-mounted).
# Re-run filtered install so new apps/api deps (e.g. nestjs-pino) land after image rebuild.
CMD ["sh", "-c", "pnpm install --filter @yaghmori/storage-service-server... --filter @workspace/validation... && pnpm --filter @workspace/validation build && nodemon --config nodemon.json"]
